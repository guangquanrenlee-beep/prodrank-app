# AI API (via ofox.ai 中转 or similar)
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.ofox.ai/v1

# Database (Supabase or local)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/prodrank

# Redis (for Celery task queue)
REDIS_URL=redis://localhost:6379/0

# Shopify App
SHOPIFY_CLIENT_ID=your-shopify-client-id
SHOPIFY_CLIENT_SECRET=shpss_your-shopify-client-secret

# Email (Resend)
RESEND_API_KEY=re_your-resend-api-key

# App
DEBUG=true
SECRET_KEY=dev-secret-change-in-production
APP_URL=https://api.prodrank.app
