{% comment %}
  ProdRank — FAQPage Schema Renderer
  Outputs the FAQPage JSON-LD into the product page <head> when the SaaS has
  generated FAQ content ("prodrank/faq" metafield). The stored value is the
  complete schema.org Question array, shared with the visible FAQ section.
  JSON-LD always outputs regardless of visible-section rendering rules.
{% endcomment %}

{% if product and product.metafields.prodrank.faq %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "FAQPage",
    "mainEntity": {{ product.metafields.prodrank.faq.value.questions | json }}
  }
  </script>
{% endif %}

{% schema %}
{
  "name": "ProdRank FAQ Schema",
  "target": "head",
  "settings": []
}
{% endschema %}
